/ views/translate.slim
/ Slim version of your translate.html

doctype html
html lang="en"
  head
    meta charset="UTF-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    title Bilingual Localization & Verification System

    / External Tailwind CSS (CDN)
    script src="https://cdn.tailwindcss.com"

    / External Font Awesome (CDN)
    link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"

    / External Google Fonts (CDN)
    link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"
    link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;700&display=swap" rel="stylesheet"

    / Link to your custom stylesheet
    link rel="stylesheet" href="/css/style.css"

  body.min-h-screen.bg-gray-50
    .container.mx-auto.px-4.py-8.max-w-6xl
      / Header
      header.mb-10.text-center
        h1.text-3xl.font-bold.text-gray-800.mb-2 Advanced Bilingual Localization & Verification System
        p.text-gray-600 High-quality English to Tamil translation with AI refinement and verification

      / Main Content
      main
        / Input Section
        section.bg-white.rounded-xl.shadow-md.p-6.mb-8
          .flex.border-b.mb-6
            button.input-tab.active.px-4.py-2.mr-2 data-tab="text" Text Input
            button.input-tab.px-4.py-2.mr-2 data-tab="file" File Upload
            button.input-tab.px-4.py-2 data-tab="url" URL

          / Text Input
          #text-input.input-content
            label.block.text-sm.font-medium.text-gray-700.mb-2 for="source-text" Enter English text to translate:
            textarea#source-text.w-full.px-3.py-2.border.border-gray-300.rounded-md.shadow-sm.focus:outline-none.focus:ring-2.focus:ring-blue-500.focus:border-blue-500 rows="6" placeholder="Paste or type your English text here..."

          / File Upload
          #file-input.input-content.hidden
            label.block.text-sm.font-medium.text-gray-700.mb-2 Upload a document:
            #file-dropzone.mt-1.flex.justify-center.px-6.pt-5.pb-6.border-2.border-gray-300.border-dashed.rounded-md
              .space-y-1.text-center
                svg.mx-auto.h-12.w-12.text-gray-400 aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 48 48"
                  path d="M28 8H12a4 4 0 00-4 4v20a4 4 0 004 4h24a4 4 0 004-4V20L28 8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  path d="M16 16h8v8h-8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                .flex.text-sm.text-gray-600
                  label.relative.cursor-pointer.bg-white.rounded-md.font-medium.text-blue-600.hover:text-blue-500.focus-within:outline-none for="file-upload"
                    span Upload a file
                    input#file-upload.sr-only accept=".txt,.doc,.docx,.md,.pdf" name="file-upload" type="file"
                  p.pl-1 or drag and drop
                p.text-xs.text-gray-500 TXT, DOC, DOCX, MD, PDF up to 10MB
            #file-info.hidden.mt-2.p-3.bg-blue-50.rounded-md
              .flex.items-center
                i.fas.fa-file-alt.text-blue-500.mr-2
                span#file-name.font-medium
                button#remove-file.ml-auto.text-red-500.hover:text-red-700
                  i.fas.fa-times
              #file-upload-progress.hidden.mt-2
                .flex.justify-between.text-sm.mb-1
                  span Uploading...
                  span#file-upload-percent 0%
                .w-full.bg-gray-200.rounded-full.h-2
                  #file-upload-bar.bg-blue-600.h-2.rounded-full style="width: 0%"

          / URL Input
          #url-input.input-content.hidden
            label.block.text-sm.font-medium.text-gray-700.mb-2 for="source-url" Enter URL to extract text from:
            input#source-url.w-full.px-3.py-2.border.border-gray-300.rounded-md.shadow-sm.focus:outline-none.focus:ring-2.focus:ring-blue-500.focus:border-blue-500 type="url" placeholder="https://example.com/document"

          .mt-6.flex.justify-between.items-center
            #api-status.text-sm.text-gray-500.hidden
              i.fas.fa-circle-notch.fa-spin.mr-1
              span Connecting to API...
            button#translate-btn.px-6.py-3.bg-blue-600.text-white.font-medium.rounded-md.shadow-sm.hover:bg-blue-700.focus:outline-none.focus:ring-2.focus:ring-offset-2.focus:ring-blue-500.transition-colors
              i.fas.fa-language.mr-2
              | Translate & Verify

        / Status Section
        section#status-section.hidden.bg-white.rounded-xl.shadow-md.p-6.mb-8
          h2.text-lg.font-medium.text-gray-800.mb-4 Translation Progress
          .progress-bar.mb-2
            #progress-fill.progress-bar-fill.w-0
          #status-messages.space-y-2
            / Status messages will be inserted here by script.js

        / Results Section
        section#results-section.hidden
          h2.text-xl.font-semibold.text-gray-800.mb-6 Translation Results

          .grid.grid-cols-1.lg:grid-cols-2.gap-6.mb-8
            / Original Text
            .bg-white.rounded-xl.shadow-md.p-6
              .flex.justify-between.items-center.mb-4
                h3.text-lg.font-medium.text-gray-800
                  i.fas.fa-file-alt.text-blue-500.mr-2
                  |  Original English Text
                button.copy-btn.px-3.py-1.text-sm.rounded-md data-target="original-text"
                  i.far.fa-copy.mr-1
                  |  Copy
              #original-text.text-gray-700.whitespace-pre-wrap

            / AI-Refined Tamil
            .translation-card.ai-refined.bg-white.rounded-xl.shadow-md.p-6
              .flex.justify-between.items-center.mb-4
                h3.text-lg.font-medium.text-gray-800
                  i.fas.fa-robot.text-green-500.mr-2
                  |  AI-Refined Tamil Translation
                button.copy-btn.px-3.py-1.text-sm.rounded-md data-target="ai-refined-tamil"
                  i.far.fa-copy.mr-1
                  |  Copy
              #ai-refined-tamil.tamil-font.text-gray-700.whitespace-pre-wrap

            / Standard Machine Translation
            .translation-card.standard.bg-white.rounded-xl.shadow-md.p-6
              .flex.justify-between.items-center.mb-4
                h3.text-lg.font-medium.text-gray-800
                  i.fas.fa-cogs.text-indigo-500.mr-2
                  |  Standard Machine Translation
                button.copy-btn.px-3.py-1.text-sm.rounded-md data-target="standard-tamil"
                  i.far.fa-copy.mr-1
                  |  Copy
              #standard-tamil.tamil-font.text-gray-700.whitespace-pre-wrap

            / Round-Trip Verification
            .translation-card.roundtrip.bg-white.rounded-xl.shadow-md.p-6
              .flex.justify-between.items-center.mb-4
                h3.text-lg.font-medium.text-gray-800
                  i.fas.fa-exchange-alt.text-yellow-500.mr-2
                  |  Round-Trip Verification (Tamil → English)
                button.copy-btn.px-3.py-1.text-sm.rounded-md data-target="roundtrip-english"
                  i.far.fa-copy.mr-1
                  |  Copy
              #roundtrip-english.text-gray-700.whitespace-pre-wrap

          / Comparison Section
          .bg-white.rounded-xl.shadow-md.p-6.mb-8
            h3.text-lg.font-medium.text-gray-800.mb-4
              i.fas.fa-balance-scale.text-purple-500.mr-2
              |  Translation Comparison
            .overflow-x-auto
              table.min-w-full.divide-y.divide-gray-200
                thead.bg-gray-50
                  tr
                    th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider scope="col" Metric
                    th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider scope="col" AI-Refined Tamil
                    th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider scope="col" Standard Machine
                tbody.bg-white.divide-y.divide-gray-200
                  tr
                    td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900 Accuracy Score
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-green-600 92%
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 78%
                  tr
                    td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900 Contextual Fit
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-green-600 Excellent
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 Good
                  tr
                    td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900 Technical Terms
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-green-600 Correct
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 Some errors
                  tr
                    td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900 Fluency
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-green-600 Natural
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 Mechanical

      / Footer
      footer.mt-12.text-center.text-sm.text-gray-500
        p Bilingual Localization & Verification System v1.0
        p.mt-1 © 2023 Language Technologies Inc. All rights reserved.

    / Link to your custom JavaScript file
    / It's generally good practice to place scripts at the end of the body for faster page load perception
    script src="/js/script.js"
