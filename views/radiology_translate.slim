/ views/radiology_translate.slim

doctype html
html lang="en"
  head
    meta charset="UTF-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    title Radiology Translation & Analysis | MemexRAG
    
    script src="https://cdn.tailwindcss.com"
    javascript:
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              tamil: ['Noto Sans Tamil', 'sans-serif'],
            },
            // Example: If you wanted to define border-b-[3px] via theme
            // borderWidth: {
            //   '3': '3px',
            // }
          }
        },
        plugins: [
          // For Play CDN, plugins are often added differently or might need specific CDN versions
          // The require('@tailwindcss/typography') syntax is for Node.js environments.
          // For Play CDN, typography is often included by default or via a separate script.
          // If it's not working, you might need to find a CDN build of the typography plugin
          // or include its styles manually. For now, let's assume the Play CDN handles basic prose.
        ],
      };
    
    link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
    link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Tamil:wght@400;700&display=swap" rel="stylesheet"
    / Your local style.css should primarily contain custom components or overrides not covered by Tailwind utilities.
    link rel="stylesheet" href="/css/style.css"

  body.bg-slate-50.text-slate-800.flex.flex-col.min-h-screen.font-sans
    / Header
    header.bg-slate-800.text-white.shadow-lg
      .container.mx-auto.p-4.flex.justify-between.items-center
        div.flex.items-center
          i.fas.fa-brain.text-3xl.mr-3.text-emerald-400
          h1.text-2xl.font-semibold MemexRAG Radiology Suite
        nav
          a.text-slate-300.hover:text-emerald-400.px-3 href="#" Reports
          a.text-slate-300.hover:text-emerald-400.px-3 href="#" Settings
          a.text-slate-300.hover:text-emerald-400.px-3 href="#" Help

    / Main Content Area
    main.container.mx-auto.p-4.md:p-6.lg:p-8.flex-grow
      / Tabs for navigation
      .tabs.mb-6.border-b.border-slate-300
        / Note: 'border-b-3' is not a standard Tailwind class. Use 'border-b-[3px]' or 'border-b-2' or 'border-b-4'
        button.tab-button.py-3.px-5.mr-1.focus:outline-none.font-medium data-tab="textTranslationTab" class="active text-white bg-slate-800 border-b-[3px] border-emerald-500"
          i.fas.fa-language.mr-2
          | Text & Document Translation
        button.tab-button.py-3.px-5.focus:outline-none.font-medium data-tab="mediaAnalysisTab" class="text-slate-500 hover:text-slate-700"
          i.fas.fa-camera-retro.mr-2
          | Media Analysis (Screenshots/UI)

      / Tab Content: Text & Document Translation
      #textTranslationTab.tab-content.active
        .grid.grid-cols-1.lg:grid-cols-2.gap-6
          / Input Area (Original Text / Document Upload)
          .bg-white.p-6.rounded-lg.shadow-md
            h2.text-xl.font-semibold.mb-4.text-slate-700 Original Content
            .flex.justify-between.items-center.mb-3
              div
                label.block.text-sm.font-medium.text-slate-500 for="sourceLangSelect" Source Language:
                select#sourceLangSelect.mt-1.block.w-full.pl-3.pr-10.py-2.text-base.border-slate-300.focus:outline-none.focus:ring-emerald-500.focus:border-emerald-500.sm:text-sm.rounded-md
                  - @source_languages ||= [['en', 'English'], ['ta', 'Tamil']]
                  - @source_languages.each do |lang_code, lang_name|
                    option value=lang_code selected=(lang_code == 'en') = lang_name
              div
                button#clearOriginalBtn.text-sm.text-slate-500.hover:text-emerald-600
                  i.fas.fa-times-circle.mr-1
                  | Clear Input

            label.block.text-sm.font-medium.text-slate-500 for="originalText"
              span#originalLangLabel English
              |  Text (or paste document content here)
            textarea#originalText.mt-1.block.w-full.h-60.p-3.border.border-slate-300.rounded-md.shadow-sm.focus:ring-emerald-500.focus:border-emerald-500.placeholder-slate-400 placeholder="Enter text to translate or upload a document..."
            .flex.justify-between.items-center.mt-2
              p#originalWordCount.text-sm.text-slate-500 0 words
              button#translateBtn.bg-emerald-500.hover:bg-emerald-600.text-white.font-semibold.py-2.px-4.rounded-md.transition.duration-150.ease-in-out.flex.items-center
                i.fas.fa-exchange-alt.mr-2
                | Translate Text

            hr.my-4.border-slate-200

            h3.text-md.font-semibold.mb-2.text-slate-700 Upload Document for Processing
            p.text-xs.text-slate-500.mb-2 Supported: .txt, .pdf, .doc, .docx
            input#docUploadInput.hidden type="file" accept=".txt,.pdf,.doc,.docx"
            button#uploadDocBtn.w-full.bg-blue-500.hover:bg-blue-600.text-white.font-semibold.py-2.px-4.rounded-md.transition.duration-150.ease-in-out.flex.items-center.justify-center
              i.fas.fa-upload.mr-2
              span Upload Document

            #docUploadProgress.w-full.bg-slate-200.rounded-full.h-2.5.mt-3.hidden
              #docUploadBar.bg-blue-600.h-2.5.rounded-full style="width: 0%"
            p#docUploadPercent.text-center.text-sm.text-slate-500.mt-1

            #docProcessingSpinner.mt-3.text-center.text-slate-600.hidden
              i.fas.fa-cog.fa-spin.text-2xl.mr-2.text-blue-500
              span Processing document on server...

            #uploadStatusIndicator.mt-3.text-sm.p-2.rounded-md

            #extractedDocContentContainer.mt-4.p-4.bg-slate-100.rounded-md.border.border-slate-200.max-h-96.overflow-y-auto.text-xs
              / Extracted document structure will be rendered here by JS

          / Output Area (Translated Text)
          .bg-white.p-6.rounded-lg.shadow-md
            h2.text-xl.font-semibold.mb-4.text-slate-700 Translation Result
            .flex.justify-between.items-center.mb-3
              div
                label.block.text-sm.font-medium.text-slate-500 for="targetLangSelect" Target Language:
                select#targetLangSelect.mt-1.block.w-full.pl-3.pr-10.py-2.text-base.border-slate-300.focus:outline-none.focus:ring-emerald-500.focus:border-emerald-500.sm:text-sm.rounded-md
                  - @target_languages ||= [['ta', 'Tamil'], ['en', 'English']]
                  - @target_languages.each do |lang_code, lang_name|
                    option value=lang_code selected=(lang_code == 'ta') = lang_name
            
            label.block.text-sm.font-medium.text-slate-500
              span#translatedLangLabel Tamil
              |  Translation
            / Corrected structure for the translation container:
            div id="translatedTextContainer" class="mt-1 p-3 min-h-[240px] border border-slate-300 rounded-md bg-slate-50 overflow-y-auto"
              div id="loadingIndicator" class="flex flex-col items-center justify-center h-full text-slate-400"
                i class="fas fa-language text-4xl mb-3"
                p 
                  | Translation will appear here
              div id="actualTranslation" class="hidden prose prose-sm max-w-none"
                / Translated content will be injected here by JS

            .flex.justify-between.items-center.mt-2
              p#translatedWordCount.text-sm.text-slate-500 0 words
              / Future: Add confidence score or feedback options

      / Tab Content: Media Analysis (Structure similar to above, ensure classes are correct)
      #mediaAnalysisTab.tab-content.hidden
        .grid.grid-cols-1.lg:grid-cols-2.gap-6
          / Media Upload & Preview Area
          .bg-white.p-6.rounded-lg.shadow-md
            h2.text-xl.font-semibold.mb-4.text-slate-700 Upload Media for Analysis
            p.text-sm.text-slate-500.mb-3 Supported: Images (PNG, JPG), Videos (MP4, MOV)

            #previewContainer.relative.w-full.h-80.border-2.border-dashed.border-slate-300.rounded-lg.flex.items-center.justify-center.bg-slate-50.transition-all.duration-200.ease-in-out.group.hover:border-emerald-500.hover:bg-slate-100
              #dropZoneOverlay.absolute.inset-0.flex.flex-col.items-center.justify-center.text-slate-400.pointer-events-none.group-hover:text-emerald-600
                i.fas.fa-cloud-upload-alt.text-4xl.mb-2
                p Drag & Drop Image/Video or Click to Upload
              input#mediaUpload.absolute.inset-0.w-full.h-full.opacity-0.cursor-pointer type="file" accept="image/png, image/jpeg, image/gif, video/mp4, video/quicktime, video/webm"
              img#previewImage.hidden.max-w-full.max-h-full.object-contain alt="Media Preview"
              video#previewVideo.hidden.max-w-full.max-h-full controls=""

            .flex.justify-between.items-center.mt-4
              button#clearMediaBtn.text-sm.text-slate-500.hover:text-red-600
                i.fas.fa-trash-alt.mr-1
                | Clear Media
              .space-x-2
                button#extractTextBtn.bg-sky-500.hover:bg-sky-600.text-white.font-medium.py-2.px-3.text-sm.rounded-md
                  i.fas.fa-file-alt.mr-1
                  | OCR
                button#analyzeUiBtn.bg-indigo-500.hover:bg-indigo-600.text-white.font-medium.py-2.px-3.text-sm.rounded-md
                  i.fas.fa-object-group.mr-1
                  | UI Elements
                button#translateMediaBtn.bg-purple-500.hover:bg-purple-600.text-white.font-medium.py-2.px-3.text-sm.rounded-md
                  i.fas.fa-globe-americas.mr-1
                  | Translate Extracted

            h3.text-md.font-semibold.mt-6.mb-2.text-slate-700 Load Sample Screenshots
            .flex.flex-wrap.gap-2
              button.bg-slate-200.hover:bg-slate-300.text-slate-700.text-xs.py-1.px-2.rounded onclick="loadSampleImage('ris_login')" RIS Login
              button.bg-slate-200.hover:bg-slate-300.text-slate-700.text-xs.py-1.px-2.rounded onclick="loadSampleImage('pacs_config')" PACS Config
              button.bg-slate-200.hover:bg-slate-300.text-slate-700.text-xs.py-1.px-2.rounded onclick="loadSampleImage('worklist_error')" Worklist Error
              button.bg-slate-200.hover:bg-slate-300.text-slate-700.text-xs.py-1.px-2.rounded onclick="loadSampleImage('dicom_viewer')" DICOM Viewer

          / Media Analysis Results Area
          .bg-white.p-6.rounded-lg.shadow-md
            .flex.justify-between.items-center.mb-4
              h2.text-xl.font-semibold.text-slate-700 Analysis Results
              .space-x-2
                button#copyResultsBtn.text-slate-500.hover:text-emerald-600.text-sm
                  i.fas.fa-copy.mr-1
                  | Copy
                button#downloadResultsBtn.text-slate-500.hover:text-emerald-600.text-sm
                  i.fas.fa-download.mr-1
                  | Download

            #mediaLoadingIndicator.hidden.flex.flex-col.items-center.justify-center.h-full.text-slate-400
              i.fas.fa-cogs.fa-spin.text-3xl.mr-2.text-emerald-500
              p Analyzing media...
            #mediaResultsPlaceholder.flex.flex-col.items-center.justify-center.h-full.text-slate-400
              i.fas.fa-microscope.text-4xl.mb-3
              p Analysis results will appear here
            #actualMediaResults.hidden.prose.prose-sm.max-w-none.h-96.overflow-y-auto.p-3.border.border-slate-200.rounded-md.bg-slate-50
              / Analysis content will be injected by JS

    / Footer
    footer.bg-slate-700.text-slate-300.text-center.p-4.mt-auto
      p &copy; #{Time.now.year} MemexRAG Solutions. Advanced AI for Radiology IT.

    / JavaScript file
    script src="/js/radiology_translate.js"