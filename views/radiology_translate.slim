/! views/radiology_translate.slim

doctype html
html lang="en"
  head
    meta charset="UTF-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    title Radiology IT Support - Document Translation
    script src="https://cdn.tailwindcss.com"
    link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    /! Link to external CSS if you move styles out
    / link rel="stylesheet" href="/css/radiology_translate.css"
    style
      | @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap');
      | @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil&display=swap'); /* Ensure Tamil font is loaded */

      | body { font-family: 'Roboto', sans-serif; background-color: #0f172a; color: #e2e8f0; }
      | .text-box { min-height: 400px; scrollbar-width: thin; scrollbar-color: #334155 #1e293b; }
      | .text-box::-webkit-scrollbar { width: 8px; }
      | .text-box::-webkit-scrollbar-track { background: #1e293b; }
      | .text-box::-webkit-scrollbar-thumb { background-color: #334155; border-radius: 4px; }
      | .highlight { background-color: rgba(74, 222, 128, 0.3); transition: background-color 0.3s; }
      | .tamil-font { font-family: 'Noto Sans Tamil', sans-serif; font-size: 1.05rem; line-height: 1.8; }
      | @keyframes pulse { 0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; } }
      | .loading { animation: pulse 1.5s infinite; }
      | .tab-content { display: none; }
      | .tab-content.active { display: block; }
      | .tab-button { transition: all 0.3s ease; }
      | .tab-button.active { background-color: #1e293b; border-bottom: 3px solid #10b981; }
      | #previewContainer { border: 2px dashed #334155; border-radius: 0.5rem; min-height: 300px; position: relative; }
      | #previewContainer.has-preview { border: none; }
      | #previewImage, #previewVideo { max-width: 100%; max-height: 400px; display: none; }
      | .drop-zone-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: rgba(15, 23, 42, 0.7); z-index: 10; border-radius: 0.5rem; }
      | .ocr-highlight { background-color: rgba(234, 179, 8, 0.3); border: 1px dashed rgba(234, 179, 8, 0.7); }

  body.min-h-screen
    .container.mx-auto.px-4.py-8
      /! Header
      header.flex.justify-between.items-center.mb-8
        .flex.items-center.space-x-3
          .bg-emerald-600.p-3.rounded-lg
            i.fas.fa-language.text-white.text-2xl
          div
            h1.text-2xl.font-bold.text-white Radiology IT Support
            p.text-sm.text-slate-400 Multilingual Support System
        .flex.space-x-4
          /! TODO: Add links or functionality to History/Settings buttons
          button.bg-slate-800.hover:bg-slate-700.text-slate-300.px-4.py-2.rounded-lg.flex.items-center.space-x-2.transition
            i.fas.fa-history
            span History
          button.bg-slate-800.hover:bg-slate-700.text-slate-300.px-4.py-2.rounded-lg.flex.items-center.space-x-2.transition
            i.fas.fa-cog
            span Settings

      /! Tabs Navigation
      .flex.border-b.border-slate-700.mb-6
        button.tab-button.active.px-6.py-3.font-medium.text-white data-tab="text-translation"
          i.fas.fa-align-left.mr-2
          | Text Translation
        button.tab-button.px-6.py-3.font-medium.text-slate-400.hover:text-white data-tab="media-analysis"
          i.fas.fa-image.mr-2
          | Screenshot/Screencast Analysis

      /! Text Translation Tab
      #text-translation.tab-content.active
        /! Translation Controls
        .bg-slate-800.rounded-xl.p-6.mb-6.shadow-lg
          .flex.flex-col.md:flex-row.md:items-center.md:justify-between.space-y-4.md:space-y-0
            .flex.items-center.space-x-4
              div
                label.block.text-sm.font-medium.text-slate-400.mb-1 for="sourceLangSelect" Source Language
                .relative
                  select#sourceLangSelect.bg-slate-900.border.border-slate-700.text-slate-300.rounded-lg.px-4.py-2.pr-8.appearance-none.focus:ring-2.focus:ring-emerald-500.focus:border-emerald-500
                    /! Populate dynamically from Sinatra route -> @source_languages
                    - @source_languages ||= [['en', 'English'], ['es', 'Spanish'], ['fr', 'French'], ['de', 'German']]
                    - @source_languages.each do |code, name|
                      option value=code selected=(code == 'en') = name
                  .pointer-events-none.absolute.inset-y-0.right-0.flex.items-center.px-2.text-slate-500
                    i.fas.fa-chevron-down
              .text-slate-500
                i.fas.fa-exchange-alt
              div
                label.block.text-sm.font-medium.text-slate-400.mb-1 for="targetLangSelect" Target Language
                .relative
                  select#targetLangSelect.bg-slate-900.border.border-slate-700.text-slate-300.rounded-lg.px-4.py-2.pr-8.appearance-none.focus:ring-2.focus:ring-emerald-500.focus:border-emerald-500
                    /! Populate dynamically from Sinatra route -> @target_languages
                    - @target_languages ||= [['ta', 'Tamil'], ['hi', 'Hindi'], ['te', 'Telugu'], ['ml', 'Malayalam']]
                    - @target_languages.each do |code, name|
                      option value=code selected=(code == 'ta') = name
                  .pointer-events-none.absolute.inset-y-0.right-0.flex.items-center.px-2.text-slate-500
                    i.fas.fa-chevron-down

            .flex.space-x-3
              button#translateBtn.bg-emerald-600.hover:bg-emerald-700.text-white.px-6.py-2.rounded-lg.flex.items-center.space-x-2.transition
                i.fas.fa-exchange-alt
                span Translate
              /! TODO: Implement document upload functionality
              button#uploadDocBtn.border.border-slate-600.hover:bg-slate-700.text-slate-300.px-4.py-2.rounded-lg.flex.items-center.space-x-2.transition
                i.fas.fa-upload
                span Upload Document
              input#docUploadInput type="file" accept=".txt,.pdf,.docx" class="hidden"

        /! Translation Area
        .grid.grid-cols-1.lg:grid-cols-2.gap-6
          /! Original Text
          .bg-slate-800.rounded-xl.p-6.shadow-lg
            .flex.justify-between.items-center.mb-4
              h2.text-lg.font-semibold.text-white Original Text (<span id="originalLangLabel">English</span>)
              .flex.space-x-2
                /! TODO: Implement microphone input
                button.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Input via Microphone"
                  i.fas.fa-microphone
                /! TODO: Implement expand functionality
                button.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Expand View"
                  i.fas.fa-expand
            .bg-slate-900.rounded-lg.p-4.border.border-slate-700
              textarea#originalText.w-full.bg-transparent.text-slate-300.outline-none.resize-none.text-box placeholder="Enter text to translate or upload a document..." rows="15"
                | Radiology Information System (RIS) is a computerized system used to manage medical imagery and associated data. RIS complements PACS (Picture Archiving and Communication System) and provides critical functionality for radiology departments, including:
                | - Patient scheduling and tracking
                | - Imaging procedure documentation
                | - Results reporting and distribution
                | - Billing and financial reporting
                | 
                | For IT support, common issues include:
                | 1. System integration problems between RIS and PACS
                | 2. Network connectivity issues affecting image transfer
                | 3. User authentication failures
                | 4. Slow system performance during peak hours
                | 5. Data backup and recovery challenges
            .flex.justify-between.items-center.mt-3.text-sm.text-slate-500
              div
                i.fas.fa-keyboard.mr-1
                span#originalWordCount 0 words
              div
                button#clearOriginalBtn.text-slate-400.hover:text-white.transition
                  i.fas.fa-trash-alt.mr-1
                  span Clear

          /! Translated Text
          .bg-slate-800.rounded-xl.p-6.shadow-lg
            .flex.justify-between.items-center.mb-4
              h2.text-lg.font-semibold.text-white Translated Text (<span id="translatedLangLabel">Tamil</span>)
              .flex.space-x-2
                /! TODO: Implement text-to-speech
                button#speakTranslatedBtn.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Speak Text"
                  i.fas.fa-volume-up
                button#copyTranslatedBtn.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Copy Text"
                  i.fas.fa-copy
                /! TODO: Implement expand functionality
                button.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Expand View"
                  i.fas.fa-expand
            .bg-slate-900.rounded-lg.p-4.border.border-slate-700
              #translatedTextContainer.w-full.text-slate-300.tamil-font.text-box
                #loadingIndicator.loading.text-center.py-20.text-slate-500
                  i.fas.fa-language.text-4xl.mb-3
                  p Translation will appear here
                #actualTranslation.hidden
                  /! Content will be populated by JavaScript after translation API call
            .flex.justify-between.items-center.mt-3.text-sm.text-slate-500
              div
                i.fas.fa-keyboard.mr-1
                span#translatedWordCount 0 words
              div
                button#downloadTranslatedBtn.text-emerald-400.hover:text-emerald-300.transition
                  i.fas.fa-download.mr-1
                  span Download

        /! Additional Features (Populate dynamically)
        .mt-8.grid.grid-cols-1.md:grid-cols-3.gap-6
          /! Glossary
          .bg-slate-800.rounded-xl.p-6.shadow-lg
            .flex.items-center.space-x-3.mb-4
              .bg-blue-600.p-2.rounded-lg
                i.fas.fa-book.text-white
              h3.text-lg.font-semibold.text-white Radiology Glossary
            .space-y-3
              - @glossary_items ||= [{term: 'RIS', definition: 'Radiology Information System'}, {term: 'PACS', definition: 'Picture Archiving and Communication System'}, {term: 'DICOM', definition: 'Digital Imaging and Communications in Medicine'}]
              - if @glossary_items.empty?
                p.text-slate-500 No glossary items available.
              - else
                - @glossary_items.each do |item|
                  .bg-slate-700.p-3.rounded-lg
                    .flex.justify-between.items-start
                      div
                        p.font-medium.text-white = item[:term]
                        p.text-sm.text-slate-400 = item[:definition]
                      /! TODO: Implement 'Add to Translation' functionality
                      button.text-blue-400.hover:text-blue-300.text-sm
                        i.fas.fa-plus.mr-1
                        | Add

          /! Recent Translations
          .bg-slate-800.rounded-xl.p-6.shadow-lg
            .flex.items-center.space-x-3.mb-4
              .bg-purple-600.p-2.rounded-lg
                i.fas.fa-clock.text-white
              h3.text-lg.font-semibold.text-white Recent Translations
            .space-y-3
              - @recent_translations ||= [{title: 'RIS-PACS integration guide', langs: 'English → Tamil', time: '2 hours ago'}, {title: 'Troubleshooting network issues', langs: 'English → Tamil', time: '1 day ago'}, {title: 'User manual for radiologists', langs: 'English → Tamil', time: '3 days ago'}]
              - if @recent_translations.empty?
                p.text-slate-500 No recent translations.
              - else
                - @recent_translations.each do |tx|
                  .bg-slate-700.p-3.rounded-lg.hover:bg-slate-600.transition.cursor-pointer
                    p.font-medium.text-white.truncate = tx[:title]
                    .flex.justify-between.items-center.mt-1
                      span.text-xs.text-slate-400 = tx[:langs]
                      span.text-xs.text-slate-500 = tx[:time]

          /! Translation Memory
          .bg-slate-800.rounded-xl.p-6.shadow-lg
            .flex.items-center.space-x-3.mb-4
              .bg-amber-600.p-2.rounded-lg
                i.fas.fa-database.text-white
              h3.text-lg.font-semibold.text-white Translation Memory
            .bg-slate-900.rounded-lg.p-4.border.border-slate-700
              .flex.items-center.justify-between.mb-3
                span.text-sm.font-medium.text-slate-300 Matched Segments
                span#tmMatchPercentage.text-xs.bg-emerald-900.text-emerald-300.px-2.py-1.rounded 0% match
              #tmResults.text-sm.space-y-3
                /! Populated by JS based on original text input
                p.text-slate-500 Translation memory results will appear here.

      /! Screenshot/Screencast Analysis Tab
      #media-analysis.tab-content
        .bg-slate-800.rounded-xl.p-6.mb-6.shadow-lg
          h2.text-xl.font-semibold.text-white.mb-4 Analyze Radiology IT Support Media
          p.text-slate-400.mb-6 Upload screenshots or screencasts of Radiology IT systems to extract and translate text, identify UI elements, and get contextual help.

          .grid.grid-cols-1.lg:grid-cols-2.gap-6
            /! Upload and Preview Section
            .bg-slate-800.rounded-xl.p-6.shadow-lg
              .flex.justify-between.items-center.mb-4
                h3.text-lg.font-semibold.text-white Upload Media
                .flex.space-x-2
                  /! TODO: Implement screen capture
                  button#captureBtn.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Capture Screen"
                    i.fas.fa-camera
                  button#clearMediaBtn.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Clear Media"
                    i.fas.fa-trash-alt

              #previewContainer.mb-4
                #dropZoneOverlay.drop-zone-overlay
                  i.fas.fa-cloud-upload-alt.text-4xl.text-slate-500.mb-3
                  p.text-slate-400.mb-2 Drag & drop screenshot or screencast here
                  p.text-sm.text-slate-500 or
                  label.mt-3.bg-emerald-600.hover:bg-emerald-700.text-white.px-4.py-2.rounded-lg.cursor-pointer.transition for="mediaUpload"
                    i.fas.fa-upload.mr-2
                    | Select File
                    input#mediaUpload type="file" accept="image/*,video/*" class="hidden"
                img#previewImage alt="Preview of uploaded image"
                video#previewVideo controls=""

              .flex.flex-wrap.gap-3.mb-4
                button#extractTextBtn.bg-blue-600.hover:bg-blue-700.text-white.px-4.py-2.rounded-lg.flex.items-center.space-x-2.transition
                  i.fas.fa-font
                  span Extract Text (OCR)
                button#analyzeUiBtn.bg-purple-600.hover:bg-purple-700.text-white.px-4.py-2.rounded-lg.flex.items-center.space-x-2.transition
                  i.fas.fa-object-group
                  span Analyze UI Elements
                button#translateMediaBtn.bg-emerald-600.hover:bg-emerald-700.text-white.px-4.py-2.rounded-lg.flex.items-center.space-x-2.transition
                  i.fas.fa-language
                  span Translate Extracted Text

              .bg-slate-900.rounded-lg.p-4.border.border-slate-700
                label.block.text-sm.font-medium.text-slate-400.mb-2 for="mediaTargetLangSelect" Target Language for Translation
                .relative
                  select#mediaTargetLangSelect.bg-slate-800.border.border-slate-700.text-slate-300.rounded-lg.px-4.py-2.pr-8.w-full.appearance-none.focus:ring-2.focus:ring-emerald-500.focus:border-emerald-500
                    /! Populate dynamically from Sinatra route -> @target_languages
                    - @target_languages.each do |code, name|
                      option value=code selected=(code == 'ta') = name
                  .pointer-events-none.absolute.inset-y-0.right-0.flex.items-center.px-2.text-slate-500
                    i.fas.fa-chevron-down

            /! Analysis Results Section
            .bg-slate-800.rounded-xl.p-6.shadow-lg
              .flex.justify-between.items-center.mb-4
                h3.text-lg.font-semibold.text-white Analysis Results
                .flex.space-x-2
                  button#copyResultsBtn.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Copy Results"
                    i.fas.fa-copy
                  button#downloadResultsBtn.text-slate-400.hover:text-white.p-2.rounded-full.hover:bg-slate-700.transition title="Download Results"
                    i.fas.fa-download

              .bg-slate-900.rounded-lg.p-4.border.border-slate-700.h-full
                #analysisResults.text-slate-300.text-box
                  #mediaLoadingIndicator.loading.text-center.py-20.text-slate-500.hidden
                    i.fas.fa-spinner.fa-spin.text-4xl.mb-3
                    p Analyzing media content...
                  #mediaResultsPlaceholder.text-center.py-20.text-slate-500
                    i.fas.fa-search.text-4xl.mb-3
                    p Extracted text and analysis will appear here
                  #actualMediaResults.hidden.space-y-4
                    /! Populated by JS after analysis API calls
                    / Example structure:
                    / .bg-slate-800.p-3.rounded-lg
                    /   h4.font-medium.text-white.mb-2 Extracted Text:
                    /   #extractedTextContent.text-slate-300
                    /     p.ocr-highlight Some extracted text...
                    / .bg-slate-800.p-3.rounded-lg
                    /   h4.font-medium.text-white.mb-2 UI Elements Identified:
                    /   .text-slate-300.space-y-2
                    /     div ...
                    / .bg-slate-800.p-3.rounded-lg
                    /   h4.font-medium.text-white.mb-2 Translated Text (Language):
                    /   .text-slate-300.tamil-font ...
                    / .bg-slate-800.p-3.rounded-lg
                    /   h4.font-medium.text-white.mb-2 Support Suggestions:
                    /   .text-slate-300.space-y-2.text-sm ...

        /! Sample Radiology UI Screens
        .bg-slate-800.rounded-xl.p-6.shadow-lg.mt-6
          h3.text-lg.font-semibold.text-white.mb-4 Common Radiology IT Screens
          p.text-slate-400.mb-4 Quick access to sample screens for analysis practice:

          .grid.grid-cols-2.md:grid-cols-4.gap-4
            - sample_screens = [{id: 'ris_login', text: 'RIS Login', img_text: 'RIS+Login'}, {id: 'pacs_config', text: 'PACS Config', img_text: 'PACS+Config'}, {id: 'worklist_error', text: 'Worklist Error', img_text: 'Worklist+Error'}, {id: 'dicom_viewer', text: 'DICOM Viewer', img_text: 'DICOM+Viewer'}]
            - sample_screens.each do |screen|
              .cursor-pointer onclick="loadSampleImage('#{screen[:id]}')"
                .bg-slate-700.rounded-lg.overflow-hidden
                  img src="https://via.placeholder.com/300x200/1e293b/64748b?text=#{screen[:img_text]}" alt="#{screen[:text]} Screen" class="w-full h-32 object-cover"
                p.text-sm.text-slate-300.mt-2.text-center = screen[:text]

    /! Link to external JS if you move script out
    / script src="/js/radiology_translate.js"
    script
      | document.addEventListener('DOMContentLoaded', function() {
      |   // Tab switching functionality
      |   document.querySelectorAll('.tab-button').forEach(button => {
      |     button.addEventListener('click', function() {
      |       document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
      |       document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
      |       this.classList.add('active');
      |       const tabId = this.getAttribute('data-tab');
      |       document.getElementById(tabId).classList.add('active');
      |     });
      |   });
      |
      |   // --- Text Translation Tab Elements ---
      |   const translateBtn = document.getElementById('translateBtn');
      |   const originalTextEl = document.getElementById('originalText');
      |   const translatedTextContainer = document.getElementById('translatedTextContainer');
      |   const loadingIndicator = document.getElementById('loadingIndicator');
      |   const actualTranslation = document.getElementById('actualTranslation');
      |   const originalWordCountEl = document.getElementById('originalWordCount');
      |   const translatedWordCountEl = document.getElementById('translatedWordCount');
      |   const clearOriginalBtn = document.getElementById('clearOriginalBtn');
      |   const copyTranslatedBtn = document.getElementById('copyTranslatedBtn');
      |   const downloadTranslatedBtn = document.getElementById('downloadTranslatedBtn');
      |   const sourceLangSelect = document.getElementById('sourceLangSelect');
      |   const targetLangSelect = document.getElementById('targetLangSelect');
      |   const originalLangLabel = document.getElementById('originalLangLabel');
      |   const translatedLangLabel = document.getElementById('translatedLangLabel');
      |   const uploadDocBtn = document.getElementById('uploadDocBtn');
      |   const docUploadInput = document.getElementById('docUploadInput');
      |
      |   // Update language labels on select change
      |   sourceLangSelect.addEventListener('change', function() {
      |     originalLangLabel.textContent = this.options[this.selectedIndex].text;
      |   });
      |   targetLangSelect.addEventListener('change', function() {
      |     translatedLangLabel.textContent = this.options[this.selectedIndex].text;
      |   });
      |
      |   // Trigger document upload input
      |   uploadDocBtn.addEventListener('click', () => docUploadInput.click());
      |   docUploadInput.addEventListener('change', handleDocumentUpload);
      |
      |   // --- Media Analysis Tab Elements ---
      |   const mediaUploadInput = document.getElementById('mediaUpload');
      |   const previewContainer = document.getElementById('previewContainer');
      |   const previewImage = document.getElementById('previewImage');
      |   const previewVideo = document.getElementById('previewVideo');
      |   const dropZoneOverlay = document.getElementById('dropZoneOverlay');
      |   const mediaLoadingIndicator = document.getElementById('mediaLoadingIndicator');
      |   const mediaResultsPlaceholder = document.getElementById('mediaResultsPlaceholder');
      |   const actualMediaResults = document.getElementById('actualMediaResults');
      |   const clearMediaBtn = document.getElementById('clearMediaBtn');
      |   const extractTextBtn = document.getElementById('extractTextBtn');
      |   const analyzeUiBtn = document.getElementById('analyzeUiBtn');
      |   const translateMediaBtn = document.getElementById('translateMediaBtn');
      |   const copyResultsBtn = document.getElementById('copyResultsBtn');
      |   const downloadResultsBtn = document.getElementById('downloadResultsBtn');
      |   const mediaTargetLangSelect = document.getElementById('mediaTargetLangSelect');
      |
      |   // --- Event Listeners ---
      |
      |   // Text Translation
      |   if (translateBtn) {
      |     translateBtn.addEventListener('click', handleTextTranslation);
      |   }
      |   if (originalTextEl) {
      |     originalTextEl.addEventListener('input', updateWordCount);
      |     updateWordCount(); // Initial count
      |   }
      |   if (clearOriginalBtn) {
      |     clearOriginalBtn.addEventListener('click', () => {
      |       originalTextEl.value = '';
      |       updateWordCount();
      |       clearTranslationResults();
      |     });
      |   }
      |   if (copyTranslatedBtn) {
      |      copyTranslatedBtn.addEventListener('click', copyTranslatedText);
      |   }
      |   if (downloadTranslatedBtn) {
      |      downloadTranslatedBtn.addEventListener('click', downloadTranslatedText);
      |   }
      |
      |   // Media Analysis
      |   if (mediaUploadInput) {
      |     mediaUploadInput.addEventListener('change', (e) => handleFileSelection(e.target.files[0]));
      |   }
      |   if (previewContainer) {
      |     previewContainer.addEventListener('dragover', handleDragOver);
      |     previewContainer.addEventListener('dragleave', handleDragLeave);
      |     previewContainer.addEventListener('drop', handleDrop);
      |   }
      |   if (clearMediaBtn) {
      |     clearMediaBtn.addEventListener('click', clearMediaPreview);
      |   }
      |   if (extractTextBtn) {
      |     extractTextBtn.addEventListener('click', () => handleMediaAnalysis('ocr'));
      |   }
      |   if (analyzeUiBtn) {
      |     analyzeUiBtn.addEventListener('click', () => handleMediaAnalysis('ui'));
      |   }
      |   if (translateMediaBtn) {
      |     translateMediaBtn.addEventListener('click', () => handleMediaAnalysis('translate'));
      |   }
      |   if (copyResultsBtn) {
      |     copyResultsBtn.addEventListener('click', copyMediaResults);
      |   }
      |   if (downloadResultsBtn) {
      |     downloadResultsBtn.addEventListener('click', downloadMediaResults);
      |   }
      |
      |   // --- Functions ---
      |
      |   function updateWordCount() {
      |     const text = originalTextEl.value.trim();
      |     const words = text ? text.split(/\s+/).length : 0;
      |     originalWordCountEl.textContent = words + ' words';
      |     // Also clear translation memory results on input change
      |     clearTranslationMemory();
      |     // TODO: Optionally trigger TM lookup here after a small delay
      |   }
      |
      |   function clearTranslationResults() {
      |     loadingIndicator.classList.remove('hidden');
